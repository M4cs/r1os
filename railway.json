{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter @r1os/web build",
    "watchPatterns": ["/web/**", "/shell/**", "/companion/src/**", "/packages/**", "/package.json", "/bun.lock", "/railway.json"]
  },
  "deploy": {
    "startCommand": "bun web/serve.ts",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
