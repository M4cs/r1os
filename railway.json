{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "web/Dockerfile",
    "watchPatterns": ["/web/**", "/shell/**", "/companion/src/**", "/packages/**", "/package.json", "/bun.lock", "/railway.json", "/.dockerignore"]
  },
  "deploy": {
    "startCommand": "bun web/serve.ts",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
