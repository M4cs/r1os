<?xml version="1.0" encoding="utf-8"?>
<!--
  r1os: features Rabbit's vendor doesn't declare but a GSI's system apps expect.

  android.software.app_widgets: without it, SystemServer never starts AppWidgetService, so
  AppWidgetManager is null and LineageOS's Launcher3 crash-loops in its loader thread
  (NullPointerException on AppWidgetManager.getInstalledProvidersForProfile). Seen on Max's R1,
  2026-10-08, LineageOS 21 GSI on Rabbit's vendor.
-->
<permissions>
    <feature name="android.software.app_widgets" />
</permissions>
