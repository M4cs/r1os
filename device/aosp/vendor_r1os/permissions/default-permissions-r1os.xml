<?xml version="1.0" encoding="utf-8"?>
<!-- The host app records for r1d's push-to-talk (ADR-0009). It's a system app on r1os's image,
     with no one to tap "Allow", so the microphone is granted at first boot. -->
<exceptions>
    <exception package="dev.r1os.host">
        <permission name="android.permission.RECORD_AUDIO" fixed="false" />
    </exception>
</exceptions>
