{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "r1os-sim",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-q",
        "-p",
        "r1d",
        "--",
        "--sim",
        "--harness",
        "--shell",
        "shell/dist"
      ],
      "port": 7171
    },
    {
      "name": "shell-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "shell",
        "dev"
      ],
      "port": 5171
    },
    {
      "name": "companion-ui",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "companion",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "web",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "web",
        "preview",
        "--port",
        "4180",
        "--strictPort"
      ],
      "port": 4180
    }
  ]
}
